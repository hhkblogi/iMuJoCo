<mujoco model="Time Sync Test">
  <option timestep="0.001"/>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1"/>
    <geom type="plane" size="2 2 0.1" rgba="0.4 0.4 0.4 1"/>

    <!-- Pendulum A: free oscillation reference (undamped) -->
    <body name="pendulum_a" pos="-0.5 0 1.5">
      <joint name="joint_a" type="hinge" axis="0 1 0" damping="0"/>
      <geom type="capsule" fromto="0 0 0 0 0 -0.5" size="0.04" rgba="0.2 0.6 0.9 1"/>
      <body pos="0 0 -0.5">
        <geom type="sphere" size="0.08" rgba="0.2 0.6 0.9 1"/>
      </body>
    </body>

    <!-- Pendulum B: actuated (control latency measurement) -->
    <body name="pendulum_b" pos="0.5 0 1.5">
      <joint name="joint_b" type="hinge" axis="0 1 0" damping="0.05"/>
      <geom type="capsule" fromto="0 0 0 0 0 -0.5" size="0.04" rgba="0.9 0.3 0.2 1"/>
      <body pos="0 0 -0.5">
        <geom type="sphere" size="0.08" rgba="0.9 0.3 0.2 1"/>
      </body>
    </body>

    <!-- Spinning wheel: continuous rotation for drift detection -->
    <body name="wheel" pos="0 0 2.5">
      <joint name="wheel_joint" type="hinge" axis="0 0 1" damping="0"/>
      <geom type="cylinder" size="0.15 0.02" rgba="0.3 0.8 0.3 1"/>
      <geom type="box" size="0.12 0.01 0.03" pos="0.1 0 0" rgba="1 1 0 1"/>
    </body>
  </worldbody>

  <actuator>
    <motor name="torque_b" joint="joint_b" gear="1"/>
    <motor name="torque_wheel" joint="wheel_joint" gear="0.1"/>
  </actuator>

  <sensor>
    <jointpos name="pos_a" joint="joint_a"/>
    <jointvel name="vel_a" joint="joint_a"/>
    <jointpos name="pos_b" joint="joint_b"/>
    <jointvel name="vel_b" joint="joint_b"/>
    <actuatorfrc name="frc_b" actuator="torque_b"/>
    <jointpos name="wheel_pos" joint="wheel_joint"/>
    <jointvel name="wheel_vel" joint="wheel_joint"/>
  </sensor>

  <keyframe>
    <key name="sync_test" qpos="0.5 0 0" qvel="0 0 6.283"/>
  </keyframe>
</mujoco>
