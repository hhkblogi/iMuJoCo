// state.fbs
// State packet: iMuJoCo → driver
// Sends simulation state back to the driver

namespace imujoco.schema;

table StatePacket {
  // Packet sequence number (for ordering/debugging)
  sequence: uint32;

  // Simulation time
  time: double;

  // Energy (potential and kinetic)
  energy_potential: double;
  energy_kinetic: double;

  // Generalized positions (length = model.nq)
  qpos: [double];

  // Generalized velocities (length = model.nv)
  qvel: [double];

  // Control values (length = model.nu)
  ctrl: [double];

  // Sensor data (length = model.nsensordata)
  sensordata: [double];

  // Time sync fields (appended for backward compatibility — default to 0)

  // Monotonic step counter (incremented per mj_step)
  step_index: uint64;

  // Sequence of the control packet that was applied to produce this state
  accepted_ctrl_seq: uint32;

  // Device steady_clock at state capture (microseconds since epoch)
  device_wall_us: uint64;

  // Model timestep in microseconds (e.g. 2000 for 0.002s)
  timestep_us: uint32;

  // Echo of control packet's echo_token (for round-trip correlation)
  echo_token: uint64;

  // === Force data (opt-in via MJRuntimeConfig.sendForceData) ===

  // Actuator forces at each joint (length = model.nv)
  qfrc_actuator: [double];

  // Gravity + Coriolis forces at each joint (length = model.nv)
  qfrc_bias: [double];

  // Internal body interaction forces (length = model.nbody * 6)
  // Force/torque through the kinematic chain (parent->child)
  // 6 values per body: (fx, fy, fz, tx, ty, tz) in world frame
  cfrc_int: [double];

  // External body forces (length = model.nbody * 6)
  // Forces from contacts, applied forces, etc.
  cfrc_ext: [double];

  // === Contact information ===

  // Number of active contacts this timestep
  ncon: int32;

  // Contact positions in world frame (length = ncon * 3)
  contact_pos: [double];

  // Contact normal forces (length = ncon)
  contact_force: [double];

  // Contact body pairs (length = ncon each)
  contact_body1: [int32];
  contact_body2: [int32];
}

root_type StatePacket;
file_identifier "STPK";
